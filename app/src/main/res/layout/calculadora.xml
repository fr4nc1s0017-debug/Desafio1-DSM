<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Calculadora"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="invisible"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Calculadora"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="invisible"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="CALCULADORA"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNumero1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese el primer número"
        android:inputType="numberDecimal|numberSigned"
        android:layout_marginBottom="16dp" />


    <TextView
        android:id="@+id/tvNumero2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Segundo número:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etNumero2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingrese el segundo número"
        android:inputType="numberDecimal|numberSigned"
        android:layout_marginBottom="24dp" />

    <!-- El resto de tus botones y TextView -->
    <Button
        android:id="@+id/btnSumar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sumar"
        android:drawableStart="@drawable/ic_suma"
        android:drawablePadding="8dp" />

    <Button
        android:id="@+id/btnRestar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Restar"
        android:drawableStart="@drawable/ic_resta"
        android:drawablePadding="8dp" />

    <Button
        android:id="@+id/btnMultiplicar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Multiplicar"
        android:drawableStart="@drawable/ic_multiplicacion"
        android:drawablePadding="8dp" />

    <Button
        android:id="@+id/btnDividir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dividir"
        android:drawableStart="@drawable/ic_division"
        android:drawablePadding="8dp" />

    <Button
        android:id="@+id/btnExponente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exponente"
        android:drawableStart="@drawable/ic_expponente"
        android:drawablePadding="8dp" />

    <Button
        android:id="@+id/btnRaiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Raíz cuadrada"
        android:drawableStart="@drawable/ic_raiz_cuadrada"
        android:drawablePadding="8dp" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resultado:"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnHistorial"
        android:layout_width="363dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ver historial" />

</LinearLayout>