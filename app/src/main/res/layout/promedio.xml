<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:rotation="0"
    android:rotationX="0"
    android:rotationY="0">

    <TextView
        android:id="@+id/textViewinvisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Titulo invisible"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="invisible"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/textViewTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="PROMEDIO DE NOTAS"
        android:textSize="28sp"
        android:textStyle="bold"
        tools:visibility="invisible" />


    <EditText
        android:id="@+id/etEstudiante"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nombre del estudiante"
        android:inputType="numberDecimal|numberSigned" />

    <EditText
        android:id="@+id/etNota1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nota 1"
        android:inputType="numberDecimal|numberSigned" />


    <EditText
        android:id="@+id/etNota2"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nota 2"
        android:inputType="numberDecimal|numberSigned" />

    <!-- El resto de tus botones y TextView -->

    <EditText
        android:id="@+id/etNota3"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nota 3"
        android:inputType="numberDecimal|numberSigned" />

    <EditText
        android:id="@+id/etNota4"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nota 4"
        android:inputType="numberDecimal|numberSigned" />

    <EditText
        android:id="@+id/etNota5"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nota 4"
        android:inputType="numberDecimal|numberSigned" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:gravity="center"
        android:text="Calcular Promedio" />

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Promedio total:"
        android:textSize="20sp" />

</LinearLayout>