<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:id="@+id/textViewTitulo0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="XD"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="invisible"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/textViewTitulo1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="XD"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="invisible"
        tools:visibility="invisible" />

    <TextView
        android:id="@+id/textViewTituloPrincipal"
        tools:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="SALARIO"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="visible" />

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Nombre completo:"

        android:inputType="text" />

    <EditText
        android:id="@+id/etSalario"
        android:layout_width="369dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Salario base:"
        android:inputType="numberDecimal" />

    <TextView
        android:id="@+id/tvAFP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descuento AFP:"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvISSS"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descuento ISSS:"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginTop="24dp" />
</LinearLayout>